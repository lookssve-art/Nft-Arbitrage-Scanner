# Magic Eden API (optional - uses public endpoints by default)
MAGIC_EDEN_API_KEY=

# eBay Browse API credentials (optional - uses scraping fallback if empty)
EBAY_APP_ID=
EBAY_CERT_ID=

# Scanner configuration
SCAN_INTERVAL_SECONDS=300
MIN_PROFIT_PERCENT=30
MAX_NFT_COUNT=250

# Currency conversion
# Leave empty to use free APIs (exchangerate-api, coingecko)
EXCHANGE_RATE_API_KEY=

# Discord webhook for #research channel (Charizard Agent)
DISCORD_WEBHOOK_URL=
